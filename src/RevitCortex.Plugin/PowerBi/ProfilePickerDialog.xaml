<Window x:Class="RevitCortex.Plugin.PowerBi.ProfilePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RVT Vortex" Height="440" Width="560" MinHeight="320" MinWidth="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#171B20"
        UseLayoutRounding="True">

    <!-- The saved profiles: pick one to load, or delete it. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,22,24,20"
          TextElement.Foreground="{StaticResource Vx.Ink}"
          TextElement.FontFamily="{StaticResource Vx.Font}"
          TextElement.FontSize="13">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="HelpText" Style="{StaticResource Vx.Text.Help}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border x:Name="ListCard" Grid.Row="1" Style="{StaticResource Vx.Card}" Margin="0,16,0,0"
                SizeChanged="ListCard_SizeChanged">
            <Grid>
                <ListBox x:Name="ProfileList" Style="{StaticResource Vx.List}"
                         MouseDoubleClick="ProfileList_DoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Vx.ListItem}">
                            <Setter Property="Height" Value="50"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="12.5" Margin="0,1,0,0"
                                               Foreground="{StaticResource Vx.Muted}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding When}" Margin="14,0,0,0" FontSize="12"
                                           FontFamily="{StaticResource Vx.Mono}"
                                           Foreground="{StaticResource Vx.Muted}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Vx.Text.Help}" Margin="24"
                           TextAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DeleteButton" Grid.Column="0" Height="36"
                    Style="{StaticResource Vx.Button.Ghost}" Click="Delete_Click"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="CancelButton" Height="36" Margin="0,0,8,0" IsCancel="True"
                        Style="{StaticResource Vx.Button.Ghost}" Click="Cancel_Click"/>
                <Button x:Name="LoadButton" Height="36" IsDefault="True"
                        Style="{StaticResource Vx.Button.Primary}" Click="Load_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
