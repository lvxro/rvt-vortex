<Window x:Class="RevitCortex.Plugin.PowerBi.ProfileNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RVT Vortex" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#171B20"
        UseLayoutRounding="True">

    <!-- Asks for the name a profile is saved under. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24,22,24,20"
                TextElement.Foreground="{StaticResource Vx.Ink}"
                TextElement.FontFamily="{StaticResource Vx.Font}"
                TextElement.FontSize="13">
        <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="HelpText" Style="{StaticResource Vx.Text.Help}" Margin="0,4,0,0"/>

        <TextBlock x:Name="NameLabel" Style="{StaticResource Vx.Text.FieldLabel}" Margin="0,18,0,5"/>
        <TextBox x:Name="NameBox" Height="34" Style="{StaticResource Vx.TextBox}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" Height="36" Margin="0,0,8,0" IsCancel="True"
                    Style="{StaticResource Vx.Button.Ghost}" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Height="36" IsDefault="True"
                    Style="{StaticResource Vx.Button.Primary}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
