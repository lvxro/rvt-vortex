<Page x:Class="RevitCortex.Plugin.UI.GeneralSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <!--
      General settings. Every section is one row: what it is on the left
      (220 px), its control on the right, a hairline underneath. The footer
      stays put while the sections scroll.
    -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid TextElement.Foreground="{StaticResource Vx.Ink}"
          TextElement.FontFamily="{StaticResource Vx.Font}"
          TextElement.FontSize="13">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="36,0,36,0">

                <!-- Update available (hidden until UpdateChecker finds a newer version) -->
                <Border x:Name="UpdateBanner" Margin="0,20,0,0" Padding="16,12,12,12"
                        Background="{StaticResource Vx.AccentSoft}"
                        BorderBrush="{StaticResource Vx.AccentStroke}" BorderThickness="1"
                        CornerRadius="12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="UpdateDetail" Style="{StaticResource Vx.Text.Help}"
                                       Foreground="{StaticResource Vx.InkSoft}" Margin="0,2,0,0"
                                       MaxHeight="56" TextTrimming="CharacterEllipsis"/>
                            <!-- Visible only while downloading -->
                            <Grid x:Name="UpdateProgressGrid" Visibility="Collapsed" Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ProgressBar x:Name="UpdateProgress" Grid.Row="0"
                                             Style="{StaticResource Vx.Progress}" Value="0"/>
                                <TextBlock x:Name="UpdateProgressText" Grid.Row="1" FontSize="12"
                                           Foreground="{StaticResource Vx.Muted}" Margin="0,6,0,0"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <!-- Only in the error state, next to "Retry" -->
                            <Button x:Name="UpdateManualButton" Margin="0,0,8,0"
                                    Style="{StaticResource Vx.Button.Ghost}"
                                    Click="UpdateManual_Click" Visibility="Collapsed"/>
                            <Button x:Name="UpdateActionButton"
                                    Style="{StaticResource Vx.Button.Primary}"
                                    Click="UpdateAction_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Server -->
                <Grid Margin="0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="SecServerTitle" Style="{StaticResource Vx.Text.Section}"/>
                        <TextBlock x:Name="SecServerHelp" Style="{StaticResource Vx.Text.Help}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Border x:Name="StatusBanner" Style="{StaticResource Vx.Card}" Padding="14,12,12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="18" Height="18" Margin="0,0,12,0"
                                      VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusHalo" Fill="{StaticResource Vx.AccentSoft}"
                                             Visibility="Collapsed"/>
                                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                             Fill="{StaticResource Vx.StrokeStrong}"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusTitle" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StatusDetail" Style="{StaticResource Vx.Text.Help}"/>
                                </StackPanel>
                                <Button x:Name="ServerToggleButton" Grid.Column="2" Margin="12,0,0,0"
                                        VerticalAlignment="Center" FontWeight="SemiBold"
                                        Style="{StaticResource Vx.Button}"
                                        Click="ServerToggle_Click"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock x:Name="PortLabel" Style="{StaticResource Vx.Text.Label}"/>
                            <TextBox x:Name="PortTextBox" Width="92" Margin="12,0,0,0" MaxLength="5"
                                     Style="{StaticResource Vx.TextBox}"
                                     FontFamily="{StaticResource Vx.Mono}"/>
                            <TextBlock x:Name="PortHint" Style="{StaticResource Vx.Text.Help}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource Vx.Divider}"/>

                <!-- Logging -->
                <Grid Margin="0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="SecLogTitle" Style="{StaticResource Vx.Text.Section}"/>
                        <TextBlock x:Name="SecLogHelp" Style="{StaticResource Vx.Text.Help}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource Vx.SegmentHost}"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <!-- Level names are the values written to settings.json: not translated. -->
                            <RadioButton x:Name="LogDebug" GroupName="VxLogLevel" Content="Debug"
                                         Style="{StaticResource Vx.Segment}" Margin="0,0,4,0"/>
                            <RadioButton x:Name="LogInfo" GroupName="VxLogLevel" Content="Info" IsChecked="True"
                                         Style="{StaticResource Vx.Segment}" Margin="0,0,4,0"/>
                            <RadioButton x:Name="LogWarning" GroupName="VxLogLevel" Content="Warning"
                                         Style="{StaticResource Vx.Segment}" Margin="0,0,4,0"/>
                            <RadioButton x:Name="LogError" GroupName="VxLogLevel" Content="Error"
                                         Style="{StaticResource Vx.Segment}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Style="{StaticResource Vx.Divider}"/>

                <!-- Protection -->
                <Grid Margin="0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="SecProtectTitle" Style="{StaticResource Vx.Text.Section}"/>
                        <TextBlock x:Name="SecProtectHelp" Style="{StaticResource Vx.Text.Help}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="ReadOnlyCheckBox" Grid.Column="2" Style="{StaticResource Vx.Switch}">
                        <StackPanel>
                            <TextBlock x:Name="ReadOnlyTitle" Style="{StaticResource Vx.Text.Strong}"/>
                            <TextBlock x:Name="ReadOnlyHelp" Style="{StaticResource Vx.Text.Help}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </Grid>
                <Border Style="{StaticResource Vx.Divider}"/>

                <!-- Error telemetry: hidden in RVT Vortex (ForkInfo.TelemetryEnabled is off) -->
                <Grid x:Name="TelemetryPanel" Margin="0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TelemetryTitle" Text="Error Telemetry"
                                   Style="{StaticResource Vx.Text.Section}"/>
                        <TextBlock x:Name="TelemetrySubtitle" Text="Pseudonymous, opt-in, no model data"
                                   Style="{StaticResource Vx.Text.Help}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="EnableTelemetryCheckBox" Grid.Column="2"
                              Style="{StaticResource Vx.Switch}"/>
                </Grid>
                <Border x:Name="TelemetrySeparator" Style="{StaticResource Vx.Divider}"/>

                <!-- Error reports -->
                <Grid Margin="0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="SupportReportsTitle" Style="{StaticResource Vx.Text.Section}"/>
                        <TextBlock x:Name="SupportReportsSubtitle" Style="{StaticResource Vx.Text.Help}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="KeepLabel" Style="{StaticResource Vx.Text.Label}"/>
                            <TextBox x:Name="KeepCountTextBox" Width="56" Margin="10,0" MaxLength="3"
                                     Style="{StaticResource Vx.TextBox}"
                                     FontFamily="{StaticResource Vx.Mono}"/>
                            <TextBlock x:Name="KeepSuffix" Style="{StaticResource Vx.Text.Label}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="OpenReportsFolderButton" Margin="0,0,8,0"
                                    Style="{StaticResource Vx.Button}"
                                    Click="OpenReportsFolder_Click"/>
                            <Button x:Name="DeleteAllReportsButton"
                                    Style="{StaticResource Vx.Button.Ghost}"
                                    Click="DeleteAllReports_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Vx.Hairline}" BorderThickness="0,1,0,0"
                Padding="36,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- The hint gives way to the save result for a few seconds. -->
                <TextBlock x:Name="FooterHint" Grid.Column="0" Style="{StaticResource Vx.Text.Help}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SaveFeedbackText" Grid.Column="0" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center" Visibility="Collapsed"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button x:Name="ResetButton" Height="36" Margin="0,0,8,0"
                            Style="{StaticResource Vx.Button.Ghost}"
                            Click="ResetDefaults_Click"/>
                    <Button x:Name="SaveButton" Height="36"
                            Style="{StaticResource Vx.Button.Primary}"
                            Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
