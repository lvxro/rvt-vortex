<Page x:Class="RevitCortex.Plugin.UI.ToolsSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <!--
      Tools: the C# scripts switch on top (the one setting here with a real
      risk), then every tool grouped by category. Groups start collapsed; a
      search or the "Disabled" filter opens the groups that match.
    -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid TextElement.Foreground="{StaticResource Vx.Ink}"
          TextElement.FontFamily="{StaticResource Vx.Font}"
          TextElement.FontSize="13">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- C# scripts (send_code_to_revit) -->
        <Grid Grid.Row="0" Margin="36,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="SecScriptsTitle" Style="{StaticResource Vx.Text.Section}"/>
                <TextBlock Text="send_code_to_revit" FontFamily="{StaticResource Vx.Mono}" FontSize="12"
                           Foreground="{StaticResource Vx.Muted}" Margin="0,3,0,0"/>
            </StackPanel>
            <CheckBox x:Name="CodeExecToggle" Grid.Column="2" Style="{StaticResource Vx.Switch}">
                <StackPanel>
                    <TextBlock x:Name="ScriptsToggleTitle" Style="{StaticResource Vx.Text.Strong}"/>
                    <DockPanel Margin="0,4,0,0" LastChildFill="True">
                        <Viewbox DockPanel.Dock="Left" Width="15" Height="15" VerticalAlignment="Top"
                                 Margin="0,2,8,0">
                            <Path Width="18" Height="18"
                                  Data="{StaticResource Vx.Icon.Warning}"
                                  Stroke="{StaticResource Vx.Caution}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Viewbox>
                        <TextBlock x:Name="ScriptsHelp" Style="{StaticResource Vx.Text.Help}"
                                   Foreground="{StaticResource Vx.InkSoft}"/>
                    </DockPanel>
                </StackPanel>
            </CheckBox>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Vx.Divider}" Margin="36,0"/>

        <!-- Heading, search, filter -->
        <Grid Grid.Row="2" Margin="36,18,36,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="ToolsHeading" Style="{StaticResource Vx.Text.Section}"/>
                <TextBlock x:Name="ToolCountText" Style="{StaticResource Vx.Text.Help}" Margin="0,1,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Width="220" Height="32" CornerRadius="8" BorderThickness="1"
                    Background="{StaticResource Vx.Well}" VerticalAlignment="Center" Margin="12,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource Vx.Stroke}"/>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Vx.Accent}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Width="14" Height="14" Margin="10,0,8,0" VerticalAlignment="Center"
                          Data="{StaticResource Vx.Icon.Search}"
                          Stroke="{StaticResource Vx.Muted}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" IsHitTestVisible="False"
                               Foreground="{StaticResource Vx.Disabled}" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Margin="0,0,8,0"
                             Style="{StaticResource Vx.TextBox.Bare}"
                             TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Vx.SegmentHost}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAll" GroupName="VxToolFilter" IsChecked="True"
                                 Style="{StaticResource Vx.Segment.Small}" Margin="0,0,4,0"
                                 Checked="Filter_Checked"/>
                    <RadioButton x:Name="FilterOn" GroupName="VxToolFilter"
                                 Style="{StaticResource Vx.Segment.Small}" Margin="0,0,4,0"
                                 Checked="Filter_Checked"/>
                    <RadioButton x:Name="FilterOff" GroupName="VxToolFilter"
                                 Style="{StaticResource Vx.Segment.Small}"
                                 Checked="Filter_Checked"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tools grouped by category -->
        <Border x:Name="ListCard" Grid.Row="3" Style="{StaticResource Vx.Card}" Margin="36,0"
                SizeChanged="ListCard_SizeChanged">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="CategoryList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Group header: click to open, link to switch the whole group -->
                                    <Border BorderBrush="{StaticResource Vx.Hairline}"
                                            BorderThickness="{Binding HeaderBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Grid.ColumnSpan="2"
                                                    Style="{StaticResource Vx.Button.Row}"
                                                    Click="GroupHeader_Click">
                                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                                    <Path Width="12" Height="12" VerticalAlignment="Center"
                                                          Stroke="{StaticResource Vx.Muted}" StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Data" Value="{StaticResource Vx.Icon.ChevronRight}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowTools}" Value="True">
                                                                        <Setter Property="Data" Value="{StaticResource Vx.Icon.ChevronDown}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <TextBlock Text="{Binding CategoryName}" FontSize="13.5"
                                                               FontWeight="SemiBold" Margin="10,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding CountText}" FontSize="12.5"
                                                               Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Vx.Muted}"/>
                                                                <Style.Triggers>
                                                                    <!-- Amber: something in this group is switched off -->
                                                                    <DataTrigger Binding="{Binding HasDisabled}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Vx.Caution}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"
                                                    Style="{StaticResource Vx.Button.Link}"
                                                    Content="{Binding GroupActionText}"
                                                    Click="GroupAction_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- Tools of the group -->
                                    <ItemsControl ItemsSource="{Binding VisibleTools}" Focusable="False"
                                                  Visibility="{Binding ShowTools, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Vx.Hairline}" BorderThickness="0,1,0,0"
                                                        Padding="38,9,16,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                            <TextBlock Text="{Binding ToolName}" FontSize="12.5"
                                                                       FontFamily="{StaticResource Vx.Mono}"/>
                                                            <!-- One line; the full text is in the tooltip -->
                                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                                       Foreground="{StaticResource Vx.Muted}"
                                                                       Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Description}"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" Style="{StaticResource Vx.Switch.Bare}"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  AutomationProperties.Name="{Binding ToolName}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Nothing to list: no tools loaded, or nothing matches the search -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="420" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource Vx.Text.Section}" TextAlignment="Center"/>
                    <TextBlock x:Name="EmptyHelp" Style="{StaticResource Vx.Text.Help}" TextAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="4" BorderBrush="{StaticResource Vx.Hairline}" BorderThickness="0,1,0,0"
                Padding="36,16" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterHint" Grid.Column="0" Style="{StaticResource Vx.Text.Help}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SaveFeedbackText" Grid.Column="0" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center" Visibility="Collapsed"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button x:Name="DisableAllButton" Height="36" Margin="0,0,8,0"
                            Style="{StaticResource Vx.Button.Ghost}"
                            Click="DisableAll_Click"/>
                    <Button x:Name="EnableAllButton" Height="36" Margin="0,0,8,0"
                            Style="{StaticResource Vx.Button.Ghost}"
                            Click="EnableAll_Click"/>
                    <Button x:Name="SaveButton" Height="36"
                            Style="{StaticResource Vx.Button.Primary}"
                            Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
