<Window x:Class="RevitCortex.Plugin.UI.AutoModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RVT Vortex"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">

    <!--
      Floating Autopilot status: a compact pill (one line, one state, one
      action) with an activity panel that opens upward on demand. The pill
      shows what a returning user needs first: is it working, did anything get
      declined, is the model saved. Detail lives in the panel.

      Shadows sit on a separate layer behind each surface so the text above
      keeps ClearType rendering.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer margin leaves room for the drop shadows. -->
    <StackPanel Margin="24"
                TextElement.Foreground="{StaticResource Vx.Ink}"
                TextElement.FontFamily="{StaticResource Vx.Font}"
                TextElement.FontSize="12">

        <!-- ── Activity panel (collapsed by default) ─────────────────── -->
        <Grid x:Name="ActivityPanel" Width="440" Margin="0,0,0,10"
              HorizontalAlignment="Center" Visibility="Collapsed">
            <Border Background="{StaticResource Vx.Surface}" CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.45" Color="#000000"/>
                </Border.Effect>
            </Border>
            <Border Background="{StaticResource Vx.Surface}"
                    BorderBrush="{StaticResource Vx.Stroke}" BorderThickness="1" CornerRadius="16">
                <StackPanel>

                    <DockPanel Margin="16,14,16,12" LastChildFill="False">
                        <Path DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Center"
                              Data="{StaticResource Vx.Icon.Vortex}"
                              Stroke="{StaticResource Vx.Accent}" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <TextBlock x:Name="PanelHeading" DockPanel.Dock="Left" Margin="10,0,0,0"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border x:Name="PanelScriptsChip" DockPanel.Dock="Left" Margin="10,0,0,0"
                                BorderBrush="{StaticResource Vx.AccentStroke}" BorderThickness="1"
                                CornerRadius="5" Padding="5,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="C#" FontFamily="{StaticResource Vx.Mono}" FontSize="10.5"
                                       FontWeight="Bold" Foreground="{StaticResource Vx.AccentText}"/>
                        </Border>
                        <TextBlock x:Name="UptimeText" DockPanel.Dock="Right"
                                   Foreground="{StaticResource Vx.Muted}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <UniformGrid Columns="4" Margin="12,0,12,12">
                        <Border Style="{StaticResource Vx.Well}" Margin="4,0" Padding="10,9">
                            <StackPanel>
                                <TextBlock x:Name="StatApproved" Text="0" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatApprovedLabel" FontSize="11.5" Foreground="{StaticResource Vx.Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Vx.Well}" Margin="4,0" Padding="10,9">
                            <StackPanel>
                                <TextBlock x:Name="StatDeclined" Text="0" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatDeclinedLabel" FontSize="11.5" Foreground="{StaticResource Vx.Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Vx.Well}" Margin="4,0" Padding="10,9">
                            <StackPanel>
                                <TextBlock x:Name="StatDialogs" Text="0" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatDialogsLabel" FontSize="11.5" Foreground="{StaticResource Vx.Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Vx.Well}" Margin="4,0" Padding="10,9">
                            <StackPanel>
                                <TextBlock x:Name="StatSaved" Text="–" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatSavedLabel" FontSize="11.5" Foreground="{StaticResource Vx.Muted}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Vx.Divider}"/>

                    <DockPanel Margin="16,10,16,4" LastChildFill="False">
                        <TextBlock x:Name="EventsHeading" DockPanel.Dock="Left"
                                   Style="{StaticResource Vx.Text.Caption}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LastActivityText" DockPanel.Dock="Right"
                                   Foreground="{StaticResource Vx.Muted}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <StackPanel x:Name="EventsPanel" Margin="16,0,16,8"/>

                    <Border Style="{StaticResource Vx.Divider}"/>

                    <DockPanel Margin="8,10,12,12" LastChildFill="False">
                        <Button x:Name="OpenLogButton" DockPanel.Dock="Left"
                                Style="{StaticResource Vx.Button.Link}" Click="OpenLog_Click"/>
                        <Button x:Name="PanelStopButton" DockPanel.Dock="Right"
                                Style="{StaticResource Vx.Button.Pill}" Click="Stop_Click"/>
                    </DockPanel>

                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Pill ──────────────────────────────────────────────────── -->
        <Grid HorizontalAlignment="Center">
            <Border Background="{StaticResource Vx.Surface}" CornerRadius="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
                </Border.Effect>
            </Border>
            <Border x:Name="Pill"
                    Background="{StaticResource Vx.Surface}"
                    BorderBrush="{StaticResource Vx.Stroke}" BorderThickness="1"
                    CornerRadius="18" Padding="12,5,5,5"
                    MouseLeftButtonDown="Pill_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">

                    <!-- State: the vortex mark (spins while the AI works) or a warning. -->
                    <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Path x:Name="Mark" Width="16" Height="16"
                              Data="{StaticResource Vx.Icon.Vortex}"
                              Stroke="{StaticResource Vx.Accent}" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="MarkRotate" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                        <Viewbox x:Name="WarnIcon" Visibility="Collapsed">
                            <Path Width="18" Height="18"
                                  Data="{StaticResource Vx.Icon.Warning}"
                                  Stroke="{StaticResource Vx.Caution}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Grid>

                    <TextBlock x:Name="HeadingText" Text="Autopilot"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <Border x:Name="ScriptsChip" Margin="9,0,0,0"
                            BorderBrush="{StaticResource Vx.AccentStroke}" BorderThickness="1"
                            CornerRadius="5" Padding="5,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="C#" FontFamily="{StaticResource Vx.Mono}" FontSize="10.5"
                                   FontWeight="Bold" Foreground="{StaticResource Vx.AccentText}"/>
                    </Border>

                    <Rectangle Width="1" Height="14" Fill="{StaticResource Vx.Stroke}"
                               VerticalAlignment="Center" Margin="11,0"/>

                    <StackPanel x:Name="ApprovedBox" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,10,0" Visibility="Collapsed">
                        <Path Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"
                              Data="{StaticResource Vx.Icon.Check}"
                              Stroke="{StaticResource Vx.Muted}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <TextBlock x:Name="ApprovedText" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="DeclinedBox" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,10,0" Visibility="Collapsed">
                        <Path Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"
                              Data="{StaticResource Vx.Icon.Cross}"
                              Stroke="{StaticResource Vx.Caution}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <TextBlock x:Name="DeclinedText" VerticalAlignment="Center"
                                   Foreground="{StaticResource Vx.Caution}"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Text="Idle"
                               Foreground="{StaticResource Vx.Muted}"
                               MaxWidth="260" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <StackPanel x:Name="SaveBox" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,12,0" Visibility="Collapsed">
                        <Path x:Name="SaveIcon" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"
                              Data="{StaticResource Vx.Icon.Disk}"
                              Stroke="{StaticResource Vx.Muted}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <Ellipse x:Name="UnsavedDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                 Fill="{StaticResource Vx.Caution}" Visibility="Collapsed"/>
                        <TextBlock x:Name="SaveText" VerticalAlignment="Center"
                                   Foreground="{StaticResource Vx.InkSoft}"/>
                    </StackPanel>

                    <Button x:Name="StartServerButton" Margin="0,0,4,0" Visibility="Collapsed"
                            Style="{StaticResource Vx.Button.PillPrimary}" Click="StartServer_Click"/>

                    <Button x:Name="ExpandButton" Margin="0,0,4,0" Visibility="Collapsed"
                            Style="{StaticResource Vx.Button.PillIcon}" Click="Expand_Click">
                        <Path x:Name="ExpandIcon" Width="12" Height="12"
                              Data="{StaticResource Vx.Icon.ChevronUp}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>

                    <Button x:Name="StopButton" Style="{StaticResource Vx.Button.Pill}" Click="Stop_Click">
                        <TextBlock x:Name="StopText" Text="Stop"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

    </StackPanel>
</Window>
