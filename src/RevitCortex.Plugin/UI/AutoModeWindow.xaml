<Window x:Class="RevitCortex.Plugin.UI.AutoModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RVT Vortex"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Loaded="Window_Loaded">

    <!--
      Compact status pill, styled after Revit 2027's dark UI chrome rather than a
      chat-app card: one line, one state color, one action. The long explanation
      lives in the tooltip. Drag anywhere outside the button to move it.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#2B323B"/>
        <SolidColorBrush x:Key="Stroke" Color="#434C58"/>
        <SolidColorBrush x:Key="Ink" Color="#E8EAED"/>
        <SolidColorBrush x:Key="Muted" Color="#9AA3AD"/>
        <SolidColorBrush x:Key="Accent" Color="#D97757"/>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#38414C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="11" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D97757"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C2654A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer margin leaves room for the drop shadow. -->
    <Grid Margin="14">
        <Border x:Name="Pill"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                CornerRadius="17" Padding="14,6,6,6"
                MouseLeftButtonDown="Pill_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal">
                <!-- State: steady accent dot, no animation. -->
                <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}"
                         VerticalAlignment="Center" Margin="0,0,9,0"/>

                <TextBlock x:Name="HeadingText" Text="Autopilot"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>

                <Rectangle Width="1" Height="14" Fill="{StaticResource Stroke}"
                           VerticalAlignment="Center" Margin="11,0"/>

                <TextBlock x:Name="StatusText" Text="Idle"
                           FontSize="12" Foreground="{StaticResource Muted}"
                           MaxWidth="300" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                <Button x:Name="StopButton" Style="{StaticResource PillButton}" Click="Stop_Click">
                    <TextBlock x:Name="StopText" Text="Stop"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
