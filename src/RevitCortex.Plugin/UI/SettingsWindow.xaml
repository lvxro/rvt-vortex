<Window x:Class="RevitCortex.Plugin.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RVT Vortex" Height="720" Width="860" MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#171B20"
        UseLayoutRounding="True">

    <!--
      Settings: a header with the product mark, two pill tabs, and one page per
      tab. Each page is a column of sections: what the setting is on the left,
      its control on the right, a hairline between sections.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid TextElement.Foreground="{StaticResource Vx.Ink}"
          TextElement.FontFamily="{StaticResource Vx.Font}"
          TextElement.FontSize="13">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="36,26,36,0">
            <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource Vx.Accent}"
                    VerticalAlignment="Center">
                <Viewbox Width="26" Height="26">
                    <Path Width="16" Height="16"
                          Data="{StaticResource Vx.Icon.Vortex}"
                          Stroke="{StaticResource Vx.AccentInk}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Viewbox>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Settings" Style="{StaticResource Vx.Text.Title}"/>
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource Vx.Muted}" Margin="0,1,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="36,20,36,18">
            <RadioButton x:Name="GeneralTab" GroupName="VxSettingsTabs" IsChecked="True"
                         Style="{StaticResource Vx.TabPill}" Margin="0,0,6,0"
                         Checked="Tab_Checked">
                <TextBlock x:Name="GeneralTabText" Text="General"/>
            </RadioButton>
            <RadioButton x:Name="ToolsTab" GroupName="VxSettingsTabs"
                         Style="{StaticResource Vx.TabPill}"
                         Checked="Tab_Checked">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToolsTabText" Text="Tools"/>
                    <TextBlock x:Name="ToolsCountText" Margin="8,0,0,0" Opacity="0.65"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Vx.Divider}"/>

        <!-- Page -->
        <Frame x:Name="ContentFrame" Grid.Row="3" NavigationUIVisibility="Hidden"
               Background="Transparent" Focusable="False"/>
    </Grid>
</Window>
