<Window x:Class="RevitCortex.Plugin.UI.UpdateNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RVT Vortex"
        Width="468" SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">

    <!--
      Update notice: a dark card in the bottom-right corner. One primary action
      per state (update, cancel, install), the version jump stated up front and
      the release notes visible before the user decides.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer margin leaves room for the drop shadow. -->
    <Grid Margin="24"
          TextElement.Foreground="{StaticResource Vx.Ink}"
          TextElement.FontFamily="{StaticResource Vx.Font}"
          TextElement.FontSize="13">
        <Border Background="{StaticResource Vx.Surface}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.45" Color="#000000"/>
            </Border.Effect>
        </Border>
        <Border x:Name="Card" Background="{StaticResource Vx.Surface}"
                BorderBrush="{StaticResource Vx.Stroke}" BorderThickness="1" CornerRadius="14"
                Padding="18" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <StackPanel>

                <!-- Header: mark, title, version jump, close -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9"
                            Background="{StaticResource Vx.Accent}" VerticalAlignment="Top">
                        <Viewbox Width="20" Height="20">
                            <Path Width="16" Height="16"
                                  Data="{StaticResource Vx.Icon.Vortex}"
                                  Stroke="{StaticResource Vx.AccentInk}" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NotifTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <StackPanel x:Name="VersionRow" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="VersionFrom" FontFamily="{StaticResource Vx.Mono}" FontSize="12"
                                       Foreground="{StaticResource Vx.Muted}" VerticalAlignment="Center"/>
                            <Path Width="14" Height="14" Margin="6,0" VerticalAlignment="Center"
                                  Data="{StaticResource Vx.Icon.Arrow}"
                                  Stroke="{StaticResource Vx.Muted}" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <TextBlock x:Name="VersionTo" FontFamily="{StaticResource Vx.Mono}" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="NotifDetail" Style="{StaticResource Vx.Text.Help}"
                                   Margin="0,3,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="2" VerticalAlignment="Top"
                            Style="{StaticResource Vx.Button.Icon}" Width="28" Height="28" Click="Close_Click">
                        <Path Width="12" Height="12"
                              Data="{StaticResource Vx.Icon.Cross}"
                              Stroke="{StaticResource Vx.Muted}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </Grid>

                <!-- Release notes (available state) -->
                <Border x:Name="NotesBox" Style="{StaticResource Vx.WellBox}" Margin="0,14,0,0" Padding="14,12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="NotesHeading" Style="{StaticResource Vx.Text.Caption}"/>
                        <ScrollViewer MaxHeight="150" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="NotesText" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource Vx.InkSoft}"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Download progress (hidden by default) -->
                <Grid x:Name="ProgressGrid" Visibility="Collapsed" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ProgressBar x:Name="ProgressBar" Grid.Row="0" Style="{StaticResource Vx.Progress}" Value="0"/>
                    <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="False">
                        <TextBlock x:Name="ProgressText" DockPanel.Dock="Left" FontSize="12"
                                   Foreground="{StaticResource Vx.Muted}"/>
                        <TextBlock x:Name="ProgressPercent" DockPanel.Dock="Right" FontSize="12"
                                   FontFamily="{StaticResource Vx.Mono}"/>
                    </DockPanel>
                </Grid>

                <!-- Confirm-install warning (hidden by default) -->
                <Border x:Name="ConfirmBorder" Visibility="Collapsed" Margin="0,14,0,0"
                        Background="{StaticResource Vx.CautionSoft}"
                        BorderBrush="{StaticResource Vx.CautionStroke}" BorderThickness="1"
                        CornerRadius="10" Padding="12,10">
                    <DockPanel LastChildFill="True">
                        <Viewbox DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0">
                            <Path Width="18" Height="18"
                                  Data="{StaticResource Vx.Icon.Warning}"
                                  Stroke="{StaticResource Vx.Caution}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Viewbox>
                        <TextBlock x:Name="ConfirmText" FontSize="12.5" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="SecondaryButton" Margin="0,0,8,0"
                            Style="{StaticResource Vx.Button.Ghost}" Click="Secondary_Click"/>
                    <Button x:Name="PrimaryButton"
                            Style="{StaticResource Vx.Button.Primary}" Click="Primary_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
