<Window x:Class="RevitCortex.Plugin.UI.AutopilotSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RVT Vortex"
        Width="488" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <!--
      Shown once when Autopilot stops, if anything happened: how long it ran,
      the totals, and the steps it declined so the user can pick them up.
      Non-modal on purpose: it must never block Revit.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24"
          TextElement.Foreground="{StaticResource Vx.Ink}"
          TextElement.FontFamily="{StaticResource Vx.Font}"
          TextElement.FontSize="13">
        <Border Background="{StaticResource Vx.Surface}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.45" Color="#000000"/>
            </Border.Effect>
        </Border>
        <Border x:Name="Card" Background="{StaticResource Vx.Surface}"
                BorderBrush="{StaticResource Vx.Stroke}" BorderThickness="1" CornerRadius="14"
                Padding="20" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <StackPanel>

                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10"
                            Background="{StaticResource Vx.RaisedStrong}" VerticalAlignment="Center">
                        <Viewbox Width="22" Height="22">
                            <Path Width="16" Height="16"
                                  Data="{StaticResource Vx.Icon.Vortex}"
                                  Stroke="{StaticResource Vx.InkSoft}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DurationText" Style="{StaticResource Vx.Text.Help}" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>

                <UniformGrid Columns="4" Margin="-4,16,-4,0">
                    <Border Style="{StaticResource Vx.WellBox}" Margin="4,0" Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="StatApproved" Text="0" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatApprovedLabel" FontSize="11.5" Foreground="{StaticResource Vx.Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Vx.WellBox}" Margin="4,0" Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="StatDeclined" Text="0" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatDeclinedLabel" FontSize="11.5" Foreground="{StaticResource Vx.Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Vx.WellBox}" Margin="4,0" Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="StatDialogs" Text="0" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatDialogsLabel" FontSize="11.5" Foreground="{StaticResource Vx.Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Vx.WellBox}" Margin="4,0" Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="StatSaved" Text="–" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatSavedLabel" FontSize="11.5" Foreground="{StaticResource Vx.Muted}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Steps declined while the user was away. -->
                <StackPanel x:Name="PendingSection" Margin="0,16,0,0">
                    <TextBlock x:Name="PendingHeading" Style="{StaticResource Vx.Text.Caption}"/>
                    <Border Margin="0,8,0,0" Background="{StaticResource Vx.CautionSoft}"
                            BorderBrush="{StaticResource Vx.CautionStroke}" BorderThickness="1" CornerRadius="10">
                        <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PendingPanel" Margin="12,4"/>
                        </ScrollViewer>
                    </Border>
                    <TextBlock x:Name="PendingNote" Style="{StaticResource Vx.Text.Help}" Margin="0,8,0,0"/>
                </StackPanel>

                <TextBlock x:Name="NothingPendingText" Style="{StaticResource Vx.Text.Help}"
                           Margin="0,16,0,0" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="OpenLogButton" Style="{StaticResource Vx.Button.Ghost}"
                            Margin="0,0,8,0" Click="OpenLog_Click"/>
                    <Button x:Name="DoneButton" Style="{StaticResource Vx.Button.Primary}"
                            IsDefault="True" IsCancel="True" Click="Done_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
